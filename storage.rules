rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Single optimized avatar per user. Client resizes to ≤320px JPEG (~70%).
    match /users/{userId}/avatar.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 350 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Sadaqah Jariyah dedication photos — public read; admin write.
    match /photos/dedications/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 400 * 1024
        && request.resource.contentType.matches('image/webp|image/jpeg');
      allow delete: if isAdmin();
    }
  }
}
